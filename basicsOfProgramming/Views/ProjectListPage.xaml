<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:basicsOfProgramming.ViewModels"
             xmlns:global="clr-namespace:basicsOfProgramming"
             xmlns:global1="clr-namespace:"
             x:Class="basicsOfProgramming.Views.ProjectListPage"
             Title="{Binding Title}">

    <ContentPage.BindingContext>
        <viewmodels:ProjectListViewModel />
    </ContentPage.BindingContext>

    <StackLayout>
        <ListView ItemsSource="{Binding Projects}" 
                  SelectedItem="{Binding SelectedProject, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding Name}" Detail="{Binding Description}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
        <Image Source="{Binding SelectedProject.ImagePath}" 
               Aspect="AspectFit" 
               HeightRequest="200" 
               Margin="10" />
        
        <Label Text="{Binding SelectedProject, StringFormat='Project: {0.Name} - {0.Description}'}" 
               HorizontalOptions="Center" 
               Margin="10" />


        <Button Text="Add Project" Command="{Binding AddProjectCommand}" />
    </StackLayout>
</ContentPage>