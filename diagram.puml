@startuml

class Task {
  - string Title
  - string? Description
  - TaskStatus Status
  - DateTime DueDate
  - string? AssignedTo
  - List<ChangeLog> ChangeLog
  + Task(string, string?, TaskStatus, DateTime, string?)
  - UpdateStatus(TaskStatus, string)
  + MarkAsCompleted()
}

class PriorityTask {
  - int Priority
  + SetPriority(int)
}

Task <|-- PriorityTask

@enduml